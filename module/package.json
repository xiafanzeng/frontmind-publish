{
  "name": "@frontmind/module-publish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "icojs": "1.0.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.10.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.4",
    "drizzle-orm": "0.45.2",
    "@frontmind/module-contracts": "workspace:*",
    "@frontmind/monitoring-contracts": "workspace:*",
    "@trpc/server": "^11.7.2",
    "zod": "4.1.12",
    "express": "^4.22.2",
    "multer": "^2.0.2",
    "react": "19.2.1",
    "lucide-react": "^0.453.0",
    "wouter": "3.7.1",
    "qrcode.react": "^4.2.0",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@trpc/client": "11.18.0",
    "@frontmind/module-ui": "workspace:*"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.0",
    "typescript": "^5.9.3",
    "@types/node": "^24.10.1",
    "@types/express": "4.17.21",
    "@types/multer": "^2.0.0",
    "@types/react": "^19.2.1",
    "vitest": "2.1.9",
    "@testing-library/react": "16.3.0",
    "jsdom": "26.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "exports": {
    ".": {
      "types": "./dist/server/domain/index.d.ts",
      "import": "./dist/server/domain/index.js",
      "default": "./dist/server/domain/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js",
      "default": "./dist/worker/index.js"
    },
    "./schema": {
      "types": "./schema/index.ts",
      "import": "./dist/schema/index.js"
    },
    "./persistence/*": {
      "types": "./server/*.ts",
      "import": "./dist/server/*.js"
    },
    "./client/*": {
      "types": "./client/*.tsx",
      "import": "./client/*.tsx"
    },
    "./client/mediaShortlist": {
      "types": "./client/mediaShortlist.ts",
      "import": "./client/mediaShortlist.ts"
    },
    "./client/types": {
      "types": "./client/types.ts",
      "import": "./client/types.ts"
    },
    "./client/deployment-smoke": {
      "types": "./client/deployment-smoke.ts",
      "import": "./client/deployment-smoke.ts"
    },
    "./client/queryState": {
      "types": "./client/queryState.ts",
      "import": "./client/queryState.ts"
    },
    "./client/editorContent": {
      "types": "./client/editorContent.ts",
      "import": "./client/editorContent.ts"
    },
    "./client/gateway": {
      "types": "./client/gateway.ts",
      "import": "./client/gateway.ts"
    },
    "./client/module-label": {
      "types": "./client/module-label.ts",
      "import": "./client/module-label.ts"
    },
    "./client/*.css": "./client/*.css",
    "./client/execution-adapter": {
      "types": "./client/execution-adapter.ts",
      "import": "./client/execution-adapter.ts"
    }
  }
}
