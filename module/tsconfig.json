{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": [
    "server/**/*.ts",
    "worker/**/*.ts",
    "schema/**/*.ts",
    "client/**/*.ts",
    "client/**/*.tsx"
  ],
  "exclude": [
    "**/*.test.ts",
    "node_modules",
    "dist",
    "**/*.test.tsx"
  ]
}
